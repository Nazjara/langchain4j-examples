<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- No Spring context, so Boot's logging defaults don't apply; logback alone would log everything at DEBUG -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
